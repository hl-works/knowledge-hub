# --- Store ---
# STORE_BACKEND: "memory" (dev/tests, in-process cosine) | "pg" (Postgres + pgvector, prod)
STORE_BACKEND=memory
# Requis si STORE_BACKEND=pg. Réutilise le Postgres HF-OS.
DATABASE_URL=postgres://user:pass@localhost:5432/knowledge

# --- Embeddings ---
# EMBEDDER: "fake" (déterministe, offline, tests) | "openai" (endpoint compatible OpenAI)
#   "openai" couvre aussi BGE-M3 / nomic self-host via un serveur d'inférence compatible OpenAI.
EMBEDDER=fake
EMBEDDING_DIM=1024
# Pour EMBEDDER=openai :
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=

# --- Ingestion ---
# Chemin local du clone knowledge-hub (source IN).
KNOWLEDGE_HUB_PATH=../knowledge-hub
