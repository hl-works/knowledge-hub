<script>
  // Slider avant/après — délégation d'événements (marche aussi si le slider est
  // ajouté dynamiquement, ex. sur le Parcours).
  (function () {
    function setPos(ba: HTMLElement, clientX: number) {
      const r = ba.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
      ba.style.setProperty('--pos', (p * 100).toFixed(1) + '%');
      const h = ba.querySelector('.ba-handle');
      if (h) h.setAttribute('aria-valuenow', String(Math.round(p * 100)));
    }
    let active: HTMLElement | null = null;
    document.addEventListener('pointerdown', (e) => {
      const ba = (e.target as HTMLElement).closest?.('.ba') as HTMLElement | null;
      if (!ba) return;
      active = ba;      setPos(ba, (e as PointerEvent).clientX);
    });
    document.addEventListener('pointermove', (e) => { if (active) setPos(active, (e as PointerEvent).clientX); });
    document.addEventListener('pointerup', () => { active = null; });
    document.addEventListener('pointercancel', () => { active = null; });
    document.addEventListener('keydown', (e) => {
      const h = document.activeElement as HTMLElement;
      if (!h || !h.classList || !h.classList.contains('ba-handle')) return;
      const ba = h.closest('.ba') as HTMLElement;
      let cur = parseFloat(getComputedStyle(ba).getPropertyValue('--pos')) || 50;
      if (e.key === 'ArrowLeft') cur = Math.max(0, cur - 4);
      else if (e.key === 'ArrowRight') cur = Math.min(100, cur + 4);
      else return;
      e.preventDefault();
      ba.style.setProperty('--pos', cur + '%');
      h.setAttribute('aria-valuenow', String(Math.round(cur)));
    });
  })();
</script>
